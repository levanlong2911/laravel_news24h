APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
VIDEO_PLANNING_QUEUE_CONNECTION=video
VIDEO_PLANNING_QUEUE=video-planning
VIDEO_CREATIVE_CONCEPT_MODE=disabled
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ---- AI Video pipeline ----
# Token Python dung de goi nguoc lai API Laravel (routes/api.php, header X-Video-Token)
VIDEO_API_TOKEN=

# Tran chi phi cho MOT cu goi Claude. Bo trong = 0.05 USD.
VIDEO_LLM_COST_CEILING_USD=

# Ban tien trinh Python o nen sau khi bam nut (§18.25).
#
# VIDEO_RUNNER_DIR RONG = TAT hoan toan: van tao duoc session, chi la phai chay
# tay `python tools/session_runner.py`. Day la mac dinh AN TOAN cho may/server
# khong co repo Python — dung khai bua mot duong dan khong ton tai.
#
# BAT BUOC dung dau `/` ke ca tren Windows: chuoi nhay kep trong .env bi xu ly
# escape, nen `"D:\1. Work\..."` lam HONG parser va Laravel khong boot duoc.
# PythonRunner tu doi lai thanh `\` khi goi cmd.exe.
#
#   Windows: VIDEO_PYTHON_BIN="D:/duong/dan/AI VIDEO/.venv/Scripts/python.exe"
#            VIDEO_RUNNER_DIR="D:/duong/dan/AI VIDEO/tools"
#   Linux:   VIDEO_PYTHON_BIN=/srv/ai-video/.venv/bin/python
#            VIDEO_RUNNER_DIR=/srv/ai-video/tools
VIDEO_PYTHON_BIN=python
VIDEO_RUNNER_DIR=
VIDEO_RUNNER_LOG_DIR=
