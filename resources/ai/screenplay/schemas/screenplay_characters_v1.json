{
    "type": "object",
    "additionalProperties": false,
    "required": [
        "characters"
    ],
    "properties": {
        "characters": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "id",
                    "name",
                    "role",
                    "kind",
                    "description",
                    "personality",
                    "appearance"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "pattern": "^ch_[a-z0-9_]{2,40}$"
                    },
                    "name": {
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 60
                    },
                    "role": {
                        "type": "string",
                        "enum": [
                            "protagonist",
                            "supporting",
                            "incidental"
                        ]
                    },
                    "kind": {
                        "type": "string",
                        "enum": [
                            "object",
                            "person",
                            "group"
                        ]
                    },
                    "description": {
                        "type": "string",
                        "minLength": 20,
                        "maxLength": 600
                    },
                    "personality": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 600
                    },
                    "appearance": {
                        "type": "string",
                        "minLength": 20,
                        "maxLength": 800
                    }
                }
            }
        }
    }
}
