{
    "type": "object",
    "additionalProperties": false,
    "required": [
        "characters",
        "protagonist_profile"
    ],
    "properties": {
        "characters": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "id",
                    "name",
                    "role",
                    "kind",
                    "description",
                    "personality",
                    "appearance"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "pattern": "^ch_[a-z0-9_]{2,40}$"
                    },
                    "name": {
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 60
                    },
                    "role": {
                        "type": "string",
                        "enum": [
                            "protagonist",
                            "supporting",
                            "incidental"
                        ]
                    },
                    "kind": {
                        "type": "string",
                        "enum": [
                            "object",
                            "person",
                            "group"
                        ]
                    },
                    "description": {
                        "type": "string",
                        "minLength": 20,
                        "maxLength": 600
                    },
                    "personality": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 600
                    },
                    "appearance": {
                        "type": "string",
                        "minLength": 20,
                        "maxLength": 800
                    }
                }
            }
        },
        "protagonist_profile": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "size_and_dimensions",
                "form_and_proportions",
                "spatial_layout",
                "deck_organization",
                "materials_and_finishes",
                "amenities",
                "windows_and_glazing",
                "wellness_and_relaxation",
                "transformable_spaces",
                "capacity",
                "construction_new_build_and_refit",
                "figures",
                "signature_features",
                "interior_spaces"
            ],
            "properties": {
                "size_and_dimensions": {
                    "type": "string",
                    "minLength": 40,
                    "maxLength": 2000
                },
                "form_and_proportions": {
                    "type": "string",
                    "minLength": 40,
                    "maxLength": 2000
                },
                "spatial_layout": {
                    "type": "string",
                    "minLength": 40,
                    "maxLength": 2000
                },
                "deck_organization": {
                    "type": "string",
                    "minLength": 40,
                    "maxLength": 2000
                },
                "materials_and_finishes": {
                    "type": "string",
                    "minLength": 40,
                    "maxLength": 2000
                },
                "amenities": {
                    "type": "string",
                    "minLength": 40,
                    "maxLength": 2000
                },
                "windows_and_glazing": {
                    "type": "string",
                    "minLength": 40,
                    "maxLength": 2000
                },
                "wellness_and_relaxation": {
                    "type": "string",
                    "minLength": 40,
                    "maxLength": 2000
                },
                "transformable_spaces": {
                    "type": "string",
                    "minLength": 40,
                    "maxLength": 2000
                },
                "capacity": {
                    "type": "string",
                    "minLength": 40,
                    "maxLength": 2000
                },
                "construction_new_build_and_refit": {
                    "type": "string",
                    "minLength": 40,
                    "maxLength": 2000
                },
                "figures": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "quantity",
                            "value",
                            "unit",
                            "origin",
                            "source_path",
                            "note"
                        ],
                        "properties": {
                            "quantity": {
                                "type": "string",
                                "enum": [
                                    "length_overall",
                                    "beam",
                                    "draft",
                                    "air_draft",
                                    "deck_count",
                                    "guest_count",
                                    "guest_cabin_count",
                                    "crew_count",
                                    "tender_count",
                                    "max_speed",
                                    "cruising_speed",
                                    "range",
                                    "gross_tonnage",
                                    "displacement"
                                ]
                            },
                            "value": {
                                "type": "string",
                                "maxLength": 20
                            },
                            "unit": {
                                "type": "string",
                                "enum": [
                                    "m",
                                    "decks",
                                    "guests",
                                    "cabins",
                                    "crew",
                                    "tenders",
                                    "kn",
                                    "nm",
                                    "GT",
                                    "t"
                                ]
                            },
                            "origin": {
                                "type": "string",
                                "enum": [
                                    "inherited",
                                    "proposed",
                                    "undetermined"
                                ]
                            },
                            "source_path": {
                                "type": "string",
                                "maxLength": 80
                            },
                            "note": {
                                "type": "string",
                                "maxLength": 200
                            }
                        }
                    }
                },
                "signature_features": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "name",
                            "origin",
                            "kind",
                            "region",
                            "location",
                            "visual_difference",
                            "fixed_and_moving_parts",
                            "standard_state",
                            "standard_geometry",
                            "other_states",
                            "motion_and_clearance",
                            "access_and_furniture",
                            "verification"
                        ],
                        "properties": {
                            "name": {
                                "type": "string",
                                "minLength": 3,
                                "maxLength": 80
                            },
                            "origin": {
                                "type": "string",
                                "enum": [
                                    "inherited",
                                    "proposed"
                                ]
                            },
                            "kind": {
                                "type": "string",
                                "enum": [
                                    "fixed",
                                    "transforming"
                                ]
                            },
                            "region": {
                                "type": "string",
                                "enum": [
                                    "bow",
                                    "forward",
                                    "midship",
                                    "aft",
                                    "stern",
                                    "port",
                                    "starboard",
                                    "port_and_starboard",
                                    "roof",
                                    "whole_vessel"
                                ]
                            },
                            "location": {
                                "type": "string",
                                "minLength": 10,
                                "maxLength": 2000
                            },
                            "visual_difference": {
                                "type": "string",
                                "minLength": 10,
                                "maxLength": 2000
                            },
                            "fixed_and_moving_parts": {
                                "type": "string",
                                "minLength": 10,
                                "maxLength": 2000
                            },
                            "standard_state": {
                                "type": "string",
                                "minLength": 3,
                                "maxLength": 120
                            },
                            "standard_geometry": {
                                "type": "string",
                                "minLength": 20,
                                "maxLength": 2000
                            },
                            "other_states": {
                                "type": "string",
                                "minLength": 3,
                                "maxLength": 2000
                            },
                            "motion_and_clearance": {
                                "type": "string",
                                "minLength": 3,
                                "maxLength": 2000
                            },
                            "access_and_furniture": {
                                "type": "string",
                                "minLength": 3,
                                "maxLength": 2000
                            },
                            "verification": {
                                "type": "string",
                                "minLength": 3,
                                "maxLength": 2000
                            }
                        }
                    }
                },
                "interior_spaces": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "space",
                            "deck",
                            "position",
                            "layout",
                            "access",
                            "materials_and_light",
                            "fixed_furniture",
                            "identity",
                            "undetermined"
                        ],
                        "properties": {
                            "space": {
                                "type": "string",
                                "pattern": "^[a-z][a-z0-9_]{1,29}$"
                            },
                            "deck": {
                                "type": "string",
                                "minLength": 3,
                                "maxLength": 120
                            },
                            "position": {
                                "type": "string",
                                "minLength": 40,
                                "maxLength": 600
                            },
                            "layout": {
                                "type": "string",
                                "minLength": 40,
                                "maxLength": 1500
                            },
                            "access": {
                                "type": "string",
                                "minLength": 20,
                                "maxLength": 600
                            },
                            "materials_and_light": {
                                "type": "string",
                                "minLength": 40,
                                "maxLength": 1200
                            },
                            "fixed_furniture": {
                                "type": "string",
                                "minLength": 20,
                                "maxLength": 800
                            },
                            "identity": {
                                "type": "string",
                                "minLength": 20,
                                "maxLength": 600
                            },
                            "undetermined": {
                                "type": "string",
                                "maxLength": 600
                            }
                        }
                    }
                }
            }
        }
    }
}
