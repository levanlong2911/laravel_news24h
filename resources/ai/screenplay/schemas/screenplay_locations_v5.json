{
    "type": "object",
    "additionalProperties": false,
    "required": [
        "locations",
        "launch"
    ],
    "properties": {
        "locations": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "id",
                    "story_use",
                    "spatial_relation",
                    "brief_space",
                    "story_name",
                    "route_evidence",
                    "name",
                    "description",
                    "enclosure",
                    "layout",
                    "connections",
                    "fixed_features",
                    "light_sources"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "pattern": "^lo_[a-z0-9_]{2,40}$"
                    },
                    "story_use": {
                        "type": "string",
                        "minLength": 20,
                        "maxLength": 400
                    },
                    "spatial_relation": {
                        "type": "string",
                        "enum": [
                            "external",
                            "subject_part"
                        ]
                    },
                    "brief_space": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "pattern": "^[a-z][a-z0-9_]{1,29}$"
                    },
                    "story_name": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "minLength": 3,
                        "maxLength": 80
                    },
                    "route_evidence": {
                        "anyOf": [
                            {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                    "from_deck",
                                    "to_deck",
                                    "side",
                                    "quote"
                                ],
                                "properties": {
                                    "from_deck": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "minLength": 3,
                                        "maxLength": 40
                                    },
                                    "to_deck": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "minLength": 3,
                                        "maxLength": 40
                                    },
                                    "side": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "enum": [
                                            "port",
                                            "starboard",
                                            null
                                        ]
                                    },
                                    "quote": {
                                        "type": "string",
                                        "minLength": 10,
                                        "maxLength": 400
                                    }
                                }
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "name": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "minLength": 3,
                        "maxLength": 60
                    },
                    "description": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "minLength": 20,
                        "maxLength": 600
                    },
                    "enclosure": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "enum": [
                            "interior",
                            "open_air",
                            null
                        ]
                    },
                    "layout": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "minLength": 40,
                        "maxLength": 1200
                    },
                    "connections": {
                        "type": "array",
                        "minItems": 0,
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "target_location_id",
                                "via"
                            ],
                            "properties": {
                                "target_location_id": {
                                    "type": "string",
                                    "pattern": "^lo_[a-z0-9_]{2,40}$"
                                },
                                "via": {
                                    "type": [
                                        "string",
                                        "null"
                                    ],
                                    "minLength": 10,
                                    "maxLength": 300
                                }
                            }
                        }
                    },
                    "fixed_features": {
                        "type": "array",
                        "minItems": 0,
                        "items": {
                            "type": "string",
                            "minLength": 3,
                            "maxLength": 200
                        }
                    },
                    "light_sources": {
                        "type": "array",
                        "minItems": 0,
                        "items": {
                            "type": "string",
                            "minLength": 3,
                            "maxLength": 200
                        }
                    }
                }
            }
        },
        "launch": {
            "anyOf": [
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "location_id",
                        "means",
                        "quote"
                    ],
                    "properties": {
                        "location_id": {
                            "type": "string",
                            "pattern": "^lo_[a-z0-9_]{2,40}$"
                        },
                        "means": {
                            "type": "string",
                            "minLength": 3,
                            "maxLength": 80
                        },
                        "quote": {
                            "type": "string",
                            "minLength": 10,
                            "maxLength": 400
                        }
                    }
                },
                {
                    "type": "null"
                }
            ]
        }
    }
}
