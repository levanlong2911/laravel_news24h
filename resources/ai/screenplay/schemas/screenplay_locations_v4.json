{
    "type": "object",
    "additionalProperties": false,
    "required": [
        "locations"
    ],
    "properties": {
        "locations": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "id",
                    "story_use",
                    "spatial_relation",
                    "brief_space",
                    "design_refs",
                    "name",
                    "description",
                    "enclosure",
                    "layout",
                    "connections",
                    "fixed_features",
                    "light_sources"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "pattern": "^lo_[a-z0-9_]{2,40}$"
                    },
                    "story_use": {
                        "type": "string",
                        "minLength": 20,
                        "maxLength": 400
                    },
                    "spatial_relation": {
                        "type": "string",
                        "enum": [
                            "external",
                            "subject_part"
                        ]
                    },
                    "brief_space": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "pattern": "^[a-z][a-z0-9_]{1,29}$"
                    },
                    "design_refs": {
                        "type": "array",
                        "minItems": 0,
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "role",
                                "id"
                            ],
                            "properties": {
                                "role": {
                                    "type": "string",
                                    "enum": [
                                        "region",
                                        "surface",
                                        "route",
                                        "basin"
                                    ]
                                },
                                "id": {
                                    "type": "string",
                                    "pattern": "^[a-z][a-z0-9_]{1,39}$"
                                }
                            }
                        }
                    },
                    "name": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "minLength": 3,
                        "maxLength": 60
                    },
                    "description": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "minLength": 20,
                        "maxLength": 600
                    },
                    "enclosure": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "enum": [
                            "interior",
                            "open_air",
                            null
                        ]
                    },
                    "layout": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "minLength": 40,
                        "maxLength": 1200
                    },
                    "connections": {
                        "type": "array",
                        "minItems": 0,
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "target_location_id",
                                "via_ref",
                                "via"
                            ],
                            "properties": {
                                "target_location_id": {
                                    "type": "string",
                                    "pattern": "^lo_[a-z0-9_]{2,40}$"
                                },
                                "via_ref": {
                                    "type": [
                                        "string",
                                        "null"
                                    ],
                                    "pattern": "^[a-z][a-z0-9_]{1,39}$"
                                },
                                "via": {
                                    "type": [
                                        "string",
                                        "null"
                                    ],
                                    "minLength": 10,
                                    "maxLength": 300
                                }
                            }
                        }
                    },
                    "fixed_features": {
                        "type": "array",
                        "minItems": 0,
                        "items": {
                            "type": "string",
                            "minLength": 3,
                            "maxLength": 200
                        }
                    },
                    "light_sources": {
                        "type": "array",
                        "minItems": 0,
                        "items": {
                            "type": "string",
                            "minLength": 3,
                            "maxLength": 200
                        }
                    }
                }
            }
        }
    }
}
