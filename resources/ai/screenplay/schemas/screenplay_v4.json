{
    "type": "object",
    "additionalProperties": false,
    "required": [
        "logline",
        "design_thesis",
        "principal_dimensions",
        "premise",
        "synopsis",
        "stage_treatments",
        "ending",
        "characters",
        "locations",
        "scenes",
        "coverage"
    ],
    "properties": {
        "logline": {
            "type": "string",
            "minLength": 20,
            "maxLength": 300
        },
        "design_thesis": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "central_idea",
                "visible_difference",
                "spatial_consequence",
                "coherence",
                "realization"
            ],
            "properties": {
                "central_idea": {
                    "type": "string",
                    "minLength": 40,
                    "maxLength": 600
                },
                "visible_difference": {
                    "type": "string",
                    "minLength": 40,
                    "maxLength": 600
                },
                "spatial_consequence": {
                    "type": "string",
                    "minLength": 40,
                    "maxLength": 600
                },
                "coherence": {
                    "type": "string",
                    "minLength": 40,
                    "maxLength": 600
                },
                "realization": {
                    "type": "string",
                    "minLength": 40,
                    "maxLength": 600
                }
            }
        },
        "principal_dimensions": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "length_m",
                "beam_m",
                "rationale"
            ],
            "properties": {
                "length_m": {
                    "type": "integer"
                },
                "beam_m": {
                    "type": "number"
                },
                "rationale": {
                    "type": "string",
                    "minLength": 60,
                    "maxLength": 500
                }
            }
        },
        "premise": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "question",
                "force",
                "device",
                "change",
                "answer"
            ],
            "properties": {
                "question": {
                    "type": "string",
                    "minLength": 20,
                    "maxLength": 400
                },
                "force": {
                    "type": "string",
                    "minLength": 20,
                    "maxLength": 400
                },
                "device": {
                    "type": "string",
                    "minLength": 20,
                    "maxLength": 400
                },
                "change": {
                    "type": "string",
                    "minLength": 20,
                    "maxLength": 400
                },
                "answer": {
                    "type": "string",
                    "minLength": 20,
                    "maxLength": 400
                }
            }
        },
        "synopsis": {
            "type": "string",
            "minLength": 200,
            "maxLength": 2500
        },
        "stage_treatments": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "stage",
                    "dramatic_purpose",
                    "observable_development",
                    "participants",
                    "handover_to_next"
                ],
                "properties": {
                    "stage": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 40
                    },
                    "dramatic_purpose": {
                        "type": "string",
                        "minLength": 40,
                        "maxLength": 600
                    },
                    "observable_development": {
                        "type": "string",
                        "minLength": 40,
                        "maxLength": 900
                    },
                    "participants": {
                        "type": "string",
                        "minLength": 20,
                        "maxLength": 400
                    },
                    "handover_to_next": {
                        "type": "string",
                        "minLength": 20,
                        "maxLength": 400
                    }
                }
            }
        },
        "ending": {
            "type": "string",
            "minLength": 60,
            "maxLength": 900
        },
        "characters": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "id",
                    "name",
                    "role",
                    "kind",
                    "description",
                    "personality",
                    "appearance"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "pattern": "^ch_[a-z0-9_]{2,40}$"
                    },
                    "name": {
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 60
                    },
                    "role": {
                        "type": "string",
                        "enum": [
                            "protagonist",
                            "supporting",
                            "incidental"
                        ]
                    },
                    "kind": {
                        "type": "string",
                        "enum": [
                            "object",
                            "person",
                            "group"
                        ]
                    },
                    "description": {
                        "type": "string",
                        "minLength": 20,
                        "maxLength": 600
                    },
                    "personality": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 600
                    },
                    "appearance": {
                        "type": "string",
                        "minLength": 20,
                        "maxLength": 800
                    }
                }
            }
        },
        "locations": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "id",
                    "name",
                    "description"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "pattern": "^lo_[a-z0-9_]{2,40}$"
                    },
                    "name": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 60
                    },
                    "description": {
                        "type": "string",
                        "minLength": 20,
                        "maxLength": 600
                    }
                }
            }
        },
        "scenes": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "id",
                    "stage",
                    "location_id",
                    "int_ext",
                    "time",
                    "character_ids",
                    "action",
                    "dialogue",
                    "sound",
                    "duration_estimate_ms",
                    "why_it_cannot_be_cut",
                    "leads_to",
                    "build_state"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "pattern": "^sc_[0-9]{2}$"
                    },
                    "stage": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 40
                    },
                    "location_id": {
                        "type": "string",
                        "pattern": "^lo_[a-z0-9_]{2,40}$"
                    },
                    "int_ext": {
                        "type": "string",
                        "enum": [
                            "INT",
                            "EXT"
                        ]
                    },
                    "time": {
                        "type": "string",
                        "enum": [
                            "DAY",
                            "NIGHT",
                            "DAWN",
                            "DUSK",
                            "CONTINUOUS"
                        ]
                    },
                    "character_ids": {
                        "type": "array",
                        "minItems": 0,
                        "items": {
                            "type": "string",
                            "pattern": "^ch_[a-z0-9_]{2,40}$"
                        }
                    },
                    "action": {
                        "type": "string",
                        "minLength": 60,
                        "maxLength": 1200
                    },
                    "dialogue": {
                        "type": "array",
                        "minItems": 0,
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "character_id",
                                "line"
                            ],
                            "properties": {
                                "character_id": {
                                    "type": "string",
                                    "pattern": "^ch_[a-z0-9_]{2,40}$"
                                },
                                "line": {
                                    "type": "string",
                                    "minLength": 2,
                                    "maxLength": 300
                                }
                            }
                        }
                    },
                    "sound": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 300
                    },
                    "duration_estimate_ms": {
                        "type": "integer"
                    },
                    "why_it_cannot_be_cut": {
                        "type": "string",
                        "minLength": 20,
                        "maxLength": 300
                    },
                    "leads_to": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 300
                    },
                    "build_state": {
                        "type": [
                            "object",
                            "null"
                        ],
                        "additionalProperties": false,
                        "required": [
                            "subject_id",
                            "state"
                        ],
                        "properties": {
                            "subject_id": {
                                "type": "string",
                                "pattern": "^ch_[a-z0-9_]{2,40}$"
                            },
                            "state": {
                                "type": "string",
                                "minLength": 3,
                                "maxLength": 300
                            }
                        }
                    }
                }
            }
        },
        "coverage": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "coverage_id",
                    "mode",
                    "scene_ids",
                    "evidence"
                ],
                "properties": {
                    "coverage_id": {
                        "type": "string",
                        "pattern": "^cov_[a-z0-9_]{3,40}$"
                    },
                    "mode": {
                        "type": "string",
                        "enum": [
                            "shown",
                            "transition",
                            "not_applicable"
                        ]
                    },
                    "scene_ids": {
                        "type": "array",
                        "minItems": 0,
                        "items": {
                            "type": "string",
                            "pattern": "^sc_[0-9]{2}$"
                        }
                    },
                    "evidence": {
                        "type": "string",
                        "minLength": 10,
                        "maxLength": 600
                    }
                }
            }
        }
    }
}
