{
    "type": "object",
    "additionalProperties": false,
    "required": [
        "locations"
    ],
    "properties": {
        "locations": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "id",
                    "name",
                    "description",
                    "story_use",
                    "spatial_relation",
                    "subject_id",
                    "layout",
                    "connections",
                    "fixed_features",
                    "light_sources"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "pattern": "^lo_[a-z0-9_]{2,40}$"
                    },
                    "name": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 60
                    },
                    "description": {
                        "type": "string",
                        "minLength": 20,
                        "maxLength": 600
                    },
                    "story_use": {
                        "type": "string",
                        "minLength": 20,
                        "maxLength": 400
                    },
                    "spatial_relation": {
                        "type": "string",
                        "enum": [
                            "external",
                            "subject_part"
                        ]
                    },
                    "subject_id": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "pattern": "^ch_[a-z0-9_]{2,40}$"
                    },
                    "layout": {
                        "type": "string",
                        "minLength": 40,
                        "maxLength": 1200
                    },
                    "connections": {
                        "type": "array",
                        "minItems": 0,
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "target_location_id",
                                "via"
                            ],
                            "properties": {
                                "target_location_id": {
                                    "type": "string",
                                    "pattern": "^lo_[a-z0-9_]{2,40}$"
                                },
                                "via": {
                                    "type": "string",
                                    "minLength": 10,
                                    "maxLength": 300
                                }
                            }
                        }
                    },
                    "fixed_features": {
                        "type": "array",
                        "minItems": 0,
                        "items": {
                            "type": "string",
                            "minLength": 3,
                            "maxLength": 200
                        }
                    },
                    "light_sources": {
                        "type": "array",
                        "minItems": 0,
                        "items": {
                            "type": "string",
                            "minLength": 3,
                            "maxLength": 200
                        }
                    }
                }
            }
        }
    }
}
