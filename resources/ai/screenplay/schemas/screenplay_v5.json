        "premise": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "question",
                "force",
                "device",
                "change",
                "answer"
            ],
            "properties": {
                "question": {
                    "type": "string",
                    "minLength": 20,
                    "maxLength": 400
