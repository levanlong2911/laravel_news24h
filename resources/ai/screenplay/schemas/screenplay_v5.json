                                        "standard_geometry": {
                                            "type": "string",
                                            "minLength": 20,
                                            "maxLength": 2000
                                        },
                                        "other_states": {
                                            "type": "string",
                                            "minLength": 3,
                                            "maxLength": 2000
                                        },
                                        "motion_and_clearance": {
                                            "type": "string",
                                            "minLength": 3,
                                            "maxLength": 2000
                                        },
                                        "access_and_furniture": {
                                            "type": "string",
                                            "minLength": 3,
                                            "maxLength": 2000
                                        },
                                        "verification": {
                                            "type": "string",
                                            "minLength": 3,
                                            "maxLength": 2000
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
