                "force": {
                    "type": "string",
                    "minLength": 20,
                    "maxLength": 400
                },
                "device": {
                    "type": "string",
                    "minLength": 20,
                    "maxLength": 400
                },
                "change": {
                    "type": "string",
                    "minLength": 20,
                    "maxLength": 400
                },
                "answer": {
                    "type": "string",
                    "minLength": 20,
                    "maxLength": 400
                }
            }
        },
        "synopsis": {
            "type": "string",
            "minLength": 200,
            "maxLength": 2500
