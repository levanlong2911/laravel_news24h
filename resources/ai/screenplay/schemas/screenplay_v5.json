                "properties": {
                    "stage": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 40
                    },
                    "dramatic_purpose": {
                        "type": "string",
                        "minLength": 40,
                        "maxLength": 600
                    },
                    "observable_development": {
                        "type": "string",
                        "minLength": 40,
                        "maxLength": 900
                    },
                    "participants": {
                        "type": "string",
                        "minLength": 20,
                        "maxLength": 400
                    },
                    "handover_to_next": {
                        "type": "string",
                        "minLength": 20,
                        "maxLength": 400
                    }
                }
            }
        },
        "ending": {
            "type": "string",
            "minLength": 60,
            "maxLength": 900
