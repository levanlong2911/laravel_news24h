                                        "visual_difference": {
                                            "type": "string",
                                            "minLength": 10,
                                            "maxLength": 2000
                                        },
                                        "fixed_and_moving_parts": {
                                            "type": "string",
                                            "minLength": 10,
                                            "maxLength": 2000
