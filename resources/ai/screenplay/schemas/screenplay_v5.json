            "type": "object",
            "additionalProperties": false,
            "required": [
                "central_idea",
                "visible_difference",
                "spatial_consequence",
                "coherence",
                "realization"
            ],
            "properties": {
                "central_idea": {
                    "type": "string",
                    "minLength": 40,
                    "maxLength": 600
                },
                "visible_difference": {
                    "type": "string",
                    "minLength": 40,
                    "maxLength": 600
                },
                "spatial_consequence": {
                    "type": "string",
                    "minLength": 40,
                    "maxLength": 600
                },
                "coherence": {
                    "type": "string",
                    "minLength": 40,
                    "maxLength": 600
                },
                "realization": {
                    "type": "string",
                    "minLength": 40,
                    "maxLength": 600
                }
            }
        },
        "principal_dimensions": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "length_m",
                "beam_m",
                "rationale"
