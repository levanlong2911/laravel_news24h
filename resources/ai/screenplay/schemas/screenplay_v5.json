        "stage_treatments": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "stage",
                    "dramatic_purpose",
                    "observable_development",
                    "participants",
                    "handover_to_next"
