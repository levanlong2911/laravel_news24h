{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superyacht.local/schemas/MotoReferencePlan",
  "title": "Moto reference plan (moto-reference-plan-v3)",
  "description": "The reference plan code builds from the approved shots, the approved model sheet and its design: every reference need of every shot, one cell for every part a design need names with what the design says about it, how each need is bound, the sources the master needs and the pinned sources. The grid and size a person chooses are kept apart from the plan.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "schema", "needs", "references", "bindings", "dependencies", "source_manifest"],
  "properties": {
    "version": { "const": "moto-reference-plan-v3" },
    "schema": { "const": "MotoReferencePlan@2.0.0" },
    "needs": { "type": "array", "items": { "$ref": "#/$defs/need" } },
    "references": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/reference" } },
    "bindings": { "type": "array", "items": { "$ref": "#/$defs/binding" } },
    "dependencies": { "type": "array", "items": { "$ref": "#/$defs/dependency" } },
    "source_manifest": {
      "type": "object",
      "required": ["shots", "design_stage_id", "design_raw_sha256", "model_sheet_image_id", "model_sheet_artifact_id", "model_sheet_sha256", "planner", "prompt", "schema", "settings"]
    }
  },
  "$defs": {
    "text": { "type": "string", "pattern": "\\S" },
    "reference_id": { "type": "string", "pattern": "^R[0-9a-f]{10}$" },
    "need_id": { "type": "string", "pattern": "^SC[0-9]{2}_SH[0-9]{2}#[0-9]+$" },
    "angle": { "type": ["number", "null"] },
    "checkpoint": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["after", "before", "label", "text", "done", "pending"],
          "properties": {
            "after": { "type": ["string", "null"] },
            "before": { "type": ["string", "null"] },
            "label": { "$ref": "#/$defs/text" },
            "text": { "$ref": "#/$defs/text" },
            "done": { "type": "array", "items": { "$ref": "#/$defs/text" } },
            "pending": { "type": "array", "items": { "$ref": "#/$defs/text" } }
          }
        }
      ]
    },
    "need": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "shot_id", "index", "kind", "target", "purpose", "state", "placement", "checkpoint", "camera"],
      "properties": {
        "id": { "$ref": "#/$defs/need_id" },
        "shot_id": { "$ref": "#/$defs/text" },
        "index": { "type": "integer", "minimum": 0 },
        "kind": { "enum": ["design", "identity", "environment", "continuity"] },
        "target": { "type": ["string", "null"] },
        "purpose": { "type": "string" },
        "state": { "type": ["string", "null"] },
        "placement": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["presentation", "location", "status", "item", "moment"],
              "properties": {
                "presentation": { "$ref": "#/$defs/text" },
                "location": { "type": ["string", "null"] },
                "status": { "$ref": "#/$defs/text" },
                "item": { "type": ["string", "null"] },
                "moment": { "type": ["string", "null"] }
              }
            }
          ]
        },
        "checkpoint": { "$ref": "#/$defs/checkpoint" },
        "camera": { "type": "object" }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "key", "kind", "part", "name", "elements", "camera", "source_views", "regime", "medium", "blocked", "lines", "needs", "shots", "purposes", "fingerprint"],
      "properties": {
        "id": { "$ref": "#/$defs/reference_id" },
        "key": { "$ref": "#/$defs/text" },
        "kind": { "const": "part" },
        "part": { "$ref": "#/$defs/text" },
        "name": { "$ref": "#/$defs/text" },
        "elements": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "camera": {
          "type": "object",
          "additionalProperties": false,
          "required": ["view", "azimuth_deg", "elevation_deg"],
          "properties": {
            "view": { "type": ["string", "null"] },
            "azimuth_deg": { "$ref": "#/$defs/angle" },
            "elevation_deg": { "$ref": "#/$defs/angle" }
          }
        },
        "source_views": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "regime": { "const": "colour" },
        "medium": { "const": "physical" },
        "blocked": { "type": "array", "maxItems": 0 },
        "lines": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } },
        "needs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/need_id" } },
        "shots": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } },
        "purposes": { "type": "array", "items": { "type": "string" } },
        "fingerprint": { "$ref": "#/$defs/text" }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["need_id", "type", "source", "rule"],
      "properties": {
        "need_id": { "$ref": "#/$defs/need_id" },
        "type": { "enum": ["model_sheet", "reference", "environment", "continuity", "none"] },
        "source": { "type": ["string", "null"] },
        "rule": { "enum": ["identity_whole", "identity_waiting_keyframe", "model_sheet_missing", "part_finished", "part_geometry", "plate", "requested_background", "previous_shot"] }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "required_by", "source"],
      "properties": {
        "id": { "enum": ["model_sheet_master", "model_sheet_greyscale"] },
        "kind": { "enum": ["approved_image", "derived_image"] },
        "required_by": { "type": "array", "items": { "$ref": "#/$defs/reference_id" } },
        "source": { "type": "object" }
      }
    }
  }
}
