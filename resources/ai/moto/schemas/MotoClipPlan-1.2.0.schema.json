{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superyacht.local/schemas/MotoClipPlan",
  "title": "Moto clip plan (moto-clip-plan-v1)",
  "description": "The clip plan code compiles from the approved shots, the approved keyframes, the phase-10 template and the render registry. No model writes it; PHP checks it before it is stored or read.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schema", "project_id", "contract", "source", "total_ms", "clips"],
  "properties": {
    "format": { "const": "moto-clip-plan-v1" },
    "schema": { "const": "MotoClipPlan@1.2.0" },
    "project_id": { "$ref": "#/$defs/id" },
    "contract": { "$ref": "#/$defs/contract" },
    "source": { "$ref": "#/$defs/source" },
    "total_ms": { "$ref": "#/$defs/positive_ms" },
    "clips": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/clip" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "\\S" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "positive_ms": { "type": "integer", "minimum": 1 },
    "contract": {
      "description": "What the prompts were compiled from, as the resolver gave it: the template, its bundle and the code that fills it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["phase_id", "phase_revision", "prompt_version", "prompt_sha256", "bundle_hash", "compiler", "builder"],
      "properties": {
        "phase_id": { "$ref": "#/$defs/id" },
        "phase_revision": { "type": "integer", "minimum": 1 },
        "prompt_version": { "$ref": "#/$defs/id" },
        "prompt_sha256": { "$ref": "#/$defs/sha256" },
        "bundle_hash": { "$ref": "#/$defs/id" },
        "compiler": { "$ref": "#/$defs/id" },
        "builder": { "$ref": "#/$defs/id" }
      }
    },
    "source": {
      "description": "The approved shot plan the clips come from, as ShotSourceService::approvedSource pins it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["planning_stage_id", "revision", "token"],
      "properties": {
        "planning_stage_id": { "$ref": "#/$defs/id" },
        "revision": { "type": "integer", "minimum": 1 },
        "token": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "stage_id", "content_hash", "selection_version", "source_fingerprint"],
          "properties": {
            "version": { "const": "shots-source-token-v1" },
            "stage_id": { "$ref": "#/$defs/id" },
            "content_hash": { "$ref": "#/$defs/id" },
            "selection_version": { "type": "integer", "minimum": 1 },
            "source_fingerprint": { "$ref": "#/$defs/id" }
          }
        }
      }
    },
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shot_id", "scene_id", "order", "render", "used", "prompt", "keyframe", "blocked", "hash"],
      "properties": {
        "shot_id": { "type": "string", "pattern": "^SC[0-9]{2}_SH[0-9]{2}$" },
        "scene_id": { "$ref": "#/$defs/id" },
        "order": { "type": "integer", "minimum": 1 },
        "render": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "model", "aspect_ratio", "resolution", "duration_ms"],
          "properties": {
            "mode": { "enum": ["image_to_video", "first_last"] },
            "model": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
            "aspect_ratio": { "type": "string", "pattern": "^[1-9][0-9]*:[1-9][0-9]*$" },
            "resolution": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
            "duration_ms": { "$ref": "#/$defs/positive_ms" }
          }
        },
        "used": {
          "description": "The part of the rendered clip the film keeps, in clip time. Phase 11 does the cutting; the prompt never asks for it.",
          "type": "object",
          "additionalProperties": false,
          "required": ["start_ms", "duration_ms"],
          "properties": {
            "start_ms": { "type": "integer", "minimum": 0 },
            "duration_ms": { "$ref": "#/$defs/positive_ms" }
          }
        },
        "prompt": {
          "description": "The prompt compiled now, or null when the shot lacks a field it cannot go without. A render freezes its own copy.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "version", "sha256"],
              "properties": {
                "text": { "type": "string", "pattern": "\\S" },
                "version": { "$ref": "#/$defs/id" },
                "sha256": { "$ref": "#/$defs/sha256" }
              }
            }
          ]
        },
        "keyframe": {
          "description": "The approved first frame of the shot and what it was made from; null until Phase 9 approves one.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["image_id", "artifact_id", "sha256", "source_token", "prompt"],
              "properties": {
                "image_id": { "$ref": "#/$defs/id" },
                "artifact_id": { "$ref": "#/$defs/id" },
                "sha256": { "$ref": "#/$defs/sha256" },
                "source_token": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["stage_id", "content_hash"],
                  "properties": {
                    "stage_id": { "$ref": "#/$defs/id" },
                    "content_hash": { "$ref": "#/$defs/id" }
                  }
                },
                "prompt": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["version", "surface_rule", "sha256"],
                  "properties": {
                    "version": { "$ref": "#/$defs/id" },
                    "surface_rule": { "$ref": "#/$defs/id" },
                    "sha256": { "$ref": "#/$defs/id" }
                  }
                }
              }
            }
          ]
        },
        "blocked": {
          "description": "Why this clip cannot be sent, or null when it can.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message"],
              "properties": {
                "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                "message": { "type": "string", "pattern": "\\S" }
              }
            }
          ]
        },
        "hash": { "$ref": "#/$defs/id" }
      },
      "allOf": [
        {
          "if": { "properties": { "keyframe": { "type": "null" } } },
          "then": { "properties": { "blocked": { "type": "object" } } }
        },
        {
          "if": { "properties": { "prompt": { "type": "null" } } },
          "then": { "properties": { "blocked": { "type": "object" } } }
        },
        {
          "if": { "properties": { "render": { "properties": { "model": { "type": "null" } } } } },
          "then": { "properties": { "blocked": { "type": "object" } } }
        },
        {
          "if": { "properties": { "render": { "properties": { "mode": { "const": "first_last" } } } } },
          "then": { "properties": { "blocked": { "type": "object" } } }
        }
      ]
    }
  }
}
