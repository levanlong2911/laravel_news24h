{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superyacht.local/schemas/MotoFilmPlan",
  "title": "Moto film plan (moto-film-plan-v1)",
  "description": "The film PHP compiles from the phase-11 policy, the approved Phase 10 clips and the cards of the script the shot plan pins. Every span is in frames of the output, [start, end). No model writes it. The schema checks the shape and the formats; PHP checks the sources, the files, the frames and how they relate. A plan with anything that blocks it is never written in this shape.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schema", "project_id", "contract", "policy", "source", "output", "timeline", "audio", "style", "clips", "cards", "warnings"],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "hex": { "description": "The SHA-256 of a file or of a stored text, as 64 hex digits.", "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "content_hash": { "description": "The SHA-256 of canonical JSON, with its prefix.", "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "ms": { "type": "integer", "minimum": 0 },
    "frame": { "type": "integer", "minimum": 0 },
    "shot_id": { "type": "string", "pattern": "^SC[0-9]{2}_SH[0-9]{2}$" },
    "transition_kind": { "enum": ["cut", "match_cut", "time_jump", "dip"] },
    "film_policy": {
      "description": "MotoFilmPolicy 1.0.0, word for word: the policy the plan was built from. A test keeps this copy equal to resources/ai/moto/schemas/MotoFilmPolicy-1.0.0.schema.json.",
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "schema", "output_profile", "timeline", "picture", "transitions", "audio", "cards"],
      "properties": {
        "format": { "const": "moto-film-policy-v1" },
        "schema": { "const": "MotoFilmPolicy@1.0.0" },
        "output_profile": {
          "description": "The id of the output profile: size, frame rate, codecs and how a source is fitted.",
          "enum": ["moto-portrait-1080p30-v1"]
        },
        "timeline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["interval", "quantization"],
          "properties": {
            "interval": {
              "description": "Every span on the film is [start, end): the end frame is the first frame after it.",
              "const": "half_open"
            },
            "quantization": {
              "description": "Every millisecond the film cuts on must fall on a frame of the output; one that does not is refused, never rounded.",
              "const": "exact"
            }
          }
        },
        "picture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["order", "trim", "retime", "crop"],
          "properties": {
            "order": { "description": "The clips run in the order of the approved shot plan.", "const": "approved_plan" },
            "trim": { "description": "Each clip gives the film only the interval its shot keeps.", "const": "approved_used_interval" },
            "retime": { "description": "No speed change, reverse, loop or freeze.", "const": false },
            "crop": { "description": "A source is never cropped.", "const": false }
          }
        },
        "transitions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed", "dip"],
          "properties": {
            "allowed": {
              "description": "The transitions the film may cut; a shot whose transition is not listed blocks the film.",
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["cut", "match_cut", "time_jump", "dip"] }
            },
            "dip": {
              "type": "object",
              "additionalProperties": false,
              "required": ["colour", "each_side_ms", "overlap"],
              "properties": {
                "colour": { "const": "black" },
                "each_side_ms": {
                  "description": "How long the picture fades to the colour at the end of the clip before and from it at the start of the clip after, inside the time each clip keeps.",
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2000
                },
                "overlap": { "description": "The two clips never overlap, so the film keeps its length.", "const": false }
              }
            }
          }
        },
        "audio": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy", "silent_clip", "boundary_treatment", "separate_tracks"],
          "properties": {
            "policy": { "description": "Only the sound each clip carries, trimmed with its picture: no music, speech, narration or effects track.", "const": "clip_only" },
            "silent_clip": { "description": "A clip with no sound gives silence for its span.", "const": "silence" },
            "boundary_treatment": { "description": "Sound cuts where the picture cuts: no J or L cut.", "const": "cut" },
            "separate_tracks": { "const": false }
          }
        },
        "cards": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "style_profile", "reading_speed"],
          "properties": {
            "text": { "description": "A card shows the text of the script word for word; it is never shortened or changed.", "const": "verbatim" },
            "style_profile": { "description": "The id of the card style: font file and its hash, size, safe area, colours, lines.", "enum": ["moto-card-style-v1"] },
            "reading_speed": {
              "type": "object",
              "additionalProperties": false,
              "required": ["unit", "warning_above"],
              "properties": {
                "unit": { "const": "words_per_second" },
                "warning_above": {
                  "description": "A card read faster than this warns; it never blocks and never changes the card.",
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 20
                }
              }
            }
          }
        }
      }
    }
  },
  "properties": {
    "format": { "const": "moto-film-plan-v1" },
    "schema": { "const": "MotoFilmPlan@1.1.0" },
    "project_id": { "$ref": "#/$defs/uuid" },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase_id", "phase_revision", "policy_sha256", "policy_hash", "bundle_hash", "builder", "composer"],
      "properties": {
        "phase_id": { "$ref": "#/$defs/uuid" },
        "phase_revision": { "type": "integer", "minimum": 1 },
        "policy_sha256": { "$ref": "#/$defs/hex" },
        "policy_hash": { "$ref": "#/$defs/content_hash" },
        "bundle_hash": { "$ref": "#/$defs/content_hash" },
        "builder": { "$ref": "#/$defs/id" },
        "composer": { "$ref": "#/$defs/id" }
      }
    },
    "policy": { "$ref": "#/$defs/film_policy" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shots", "clips", "script"],
      "properties": {
        "shots": {
          "type": "object",
          "additionalProperties": false,
          "required": ["planning_stage_id", "revision", "token"],
          "properties": {
            "planning_stage_id": { "$ref": "#/$defs/uuid" },
            "revision": { "type": "integer", "minimum": 1 },
            "token": {
              "type": "object",
              "additionalProperties": false,
              "required": ["version", "stage_id", "content_hash", "selection_version", "source_fingerprint"],
              "properties": {
                "version": { "$ref": "#/$defs/id" },
                "stage_id": { "$ref": "#/$defs/uuid" },
                "content_hash": { "$ref": "#/$defs/content_hash" },
                "selection_version": { "type": "integer", "minimum": 1 },
                "source_fingerprint": { "$ref": "#/$defs/content_hash" }
              }
            }
          }
        },
        "clips": {
          "description": "The Phase 10 manifest of approved clips, by its own hash.",
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "hash", "hash_version", "selection_version"],
          "properties": {
            "format": { "$ref": "#/$defs/id" },
            "hash": { "$ref": "#/$defs/content_hash" },
            "hash_version": { "$ref": "#/$defs/id" },
            "selection_version": { "type": "integer", "minimum": 1 }
          }
        },
        "script": {
          "description": "The script the shot plan pins, through its scene plan.",
          "type": "object",
          "additionalProperties": false,
          "required": ["stage_id", "content_hash", "scenes_stage_id"],
          "properties": {
            "stage_id": { "$ref": "#/$defs/uuid" },
            "content_hash": { "$ref": "#/$defs/content_hash" },
            "scenes_stage_id": { "$ref": "#/$defs/uuid" }
          }
        }
      }
    },
    "output": {
      "description": "A copy of the output profile the policy names, with the hash of that copy.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "width", "height", "fps", "video_codec", "encoder", "pixel_format", "crf", "audio_codec", "sample_rate", "channels", "fit", "pad_colour", "aspect_tolerance", "hash"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "width": { "type": "integer", "minimum": 2 },
        "height": { "type": "integer", "minimum": 2 },
        "fps": { "enum": [24, 25, 30] },
        "video_codec": { "const": "h264" },
        "encoder": { "const": "libx264" },
        "pixel_format": { "const": "yuv420p" },
        "crf": { "type": "integer", "minimum": 16, "maximum": 28 },
        "audio_codec": { "const": "aac" },
        "sample_rate": { "const": 48000 },
        "channels": { "const": 2 },
        "fit": { "const": "scale_pad" },
        "pad_colour": { "const": "black" },
        "aspect_tolerance": { "type": "number", "minimum": 0, "maximum": 0.1 },
        "hash": { "$ref": "#/$defs/content_hash" }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interval", "quantization", "fps", "total_ms", "total_frames"],
      "properties": {
        "interval": { "const": "half_open" },
        "quantization": { "const": "exact" },
        "fps": { "enum": [24, 25, 30] },
        "total_ms": { "type": "integer", "minimum": 1 },
        "total_frames": { "type": "integer", "minimum": 1 }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "silent_clip", "boundary_treatment", "separate_tracks", "sample_rate", "channels"],
      "properties": {
        "policy": { "const": "clip_only" },
        "silent_clip": { "const": "silence" },
        "boundary_treatment": { "const": "cut" },
        "separate_tracks": { "const": false },
        "sample_rate": { "const": 48000 },
        "channels": { "const": 2 }
      }
    },
    "style": {
      "description": "A copy of the card style the policy names, with the hash of that copy.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "font", "size_px", "line_height_px", "colour", "border", "safe_area", "align", "anchor", "max_lines", "wrap", "measure", "language", "word_counter", "hash"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "font": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "family", "licence"],
          "properties": {
            "path": { "$ref": "#/$defs/id" },
            "sha256": { "$ref": "#/$defs/hex" },
            "family": { "$ref": "#/$defs/id" },
            "licence": { "$ref": "#/$defs/id" }
          }
        },
        "size_px": { "type": "integer", "minimum": 8, "maximum": 400 },
        "line_height_px": { "type": "integer", "minimum": 8, "maximum": 600 },
        "colour": { "enum": ["white", "black"] },
        "border": {
          "type": "object",
          "additionalProperties": false,
          "required": ["colour", "width_px"],
          "properties": {
            "colour": { "enum": ["white", "black"] },
            "width_px": { "type": "integer", "minimum": 0, "maximum": 20 }
          }
        },
        "safe_area": {
          "type": "object",
          "additionalProperties": false,
          "required": ["top_px", "right_px", "bottom_px", "left_px"],
          "properties": {
            "top_px": { "type": "integer", "minimum": 0 },
            "right_px": { "type": "integer", "minimum": 0 },
            "bottom_px": { "type": "integer", "minimum": 0 },
            "left_px": { "type": "integer", "minimum": 0 }
          }
        },
        "align": { "const": "centre" },
        "anchor": { "const": "last_baseline_on_safe_bottom" },
        "max_lines": { "type": "integer", "minimum": 1, "maximum": 6 },
        "wrap": { "const": "words" },
        "measure": { "const": "gd-freetype" },
        "language": { "const": "en" },
        "word_counter": { "const": "whitespace_tokens" },
        "hash": { "$ref": "#/$defs/content_hash" }
      }
    },
    "clips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["shot_id", "scene_id", "order", "render_id", "request_hash", "decision", "artifact", "measured", "trim_start_ms", "used_duration_ms", "timeline_start_ms", "timeline_end_ms", "timeline_start_frame", "duration_frames", "transition_in", "fade_in_frames", "fade_out_frames", "audio", "protected_results"],
        "properties": {
          "shot_id": { "$ref": "#/$defs/shot_id" },
          "scene_id": { "type": "string", "pattern": "^SC[0-9]{2}$" },
          "order": { "type": "integer", "minimum": 1 },
          "render_id": { "$ref": "#/$defs/uuid" },
          "request_hash": { "type": "string", "minLength": 1 },
          "decision": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "selection_version", "intent_version"],
            "properties": {
              "id": { "$ref": "#/$defs/uuid" },
              "selection_version": { "type": "integer", "minimum": 1 },
              "intent_version": { "type": "integer", "minimum": 1 }
            }
          },
          "artifact": {
            "type": "object",
            "additionalProperties": false,
            "required": ["disk", "path", "sha256"],
            "properties": {
              "disk": { "$ref": "#/$defs/id" },
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "$ref": "#/$defs/hex" }
            }
          },
          "measured": {
            "type": "object",
            "additionalProperties": false,
            "required": ["duration_ms", "width", "height", "bytes", "has_audio"],
            "properties": {
              "duration_ms": { "type": "integer", "minimum": 1 },
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 },
              "bytes": { "type": "integer", "minimum": 1 },
              "has_audio": { "type": "boolean" }
            }
          },
          "trim_start_ms": { "$ref": "#/$defs/ms" },
          "used_duration_ms": { "type": "integer", "minimum": 1 },
          "timeline_start_ms": { "$ref": "#/$defs/ms" },
          "timeline_end_ms": { "type": "integer", "minimum": 1 },
          "timeline_start_frame": { "$ref": "#/$defs/frame" },
          "duration_frames": { "type": "integer", "minimum": 1 },
          "transition_in": {
            "description": "null for the first clip; the shot plan's transition into every other clip and what the film does with it.",
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "effect"],
                "properties": {
                  "kind": { "$ref": "#/$defs/transition_kind" },
                  "effect": { "enum": ["straight", "dip"] }
                }
              }
            ]
          },
          "fade_in_frames": { "$ref": "#/$defs/frame" },
          "fade_out_frames": { "$ref": "#/$defs/frame" },
          "audio": { "enum": ["clip", "silence"] },
          "protected_results": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["beat", "result_at_ms", "film_frame"],
              "properties": {
                "beat": { "type": "string", "pattern": "^B[0-9]+$" },
                "result_at_ms": { "$ref": "#/$defs/ms" },
                "film_frame": { "$ref": "#/$defs/frame" }
              }
            }
          }
        }
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_card_id", "source_path", "source_script_stage_id", "type", "text", "start_ms", "end_ms", "start_frame", "end_frame", "style_id", "style_hash", "font_sha256", "lines", "words", "words_per_second"],
        "properties": {
          "source_card_id": { "type": "string", "pattern": "^[0-9a-f-]{36}#/data/text_cards/[0-9]+$" },
          "source_path": { "type": "string", "pattern": "^/data/text_cards/[0-9]+$" },
          "source_script_stage_id": { "$ref": "#/$defs/uuid" },
          "type": { "$ref": "#/$defs/id" },
          "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "start_ms": { "$ref": "#/$defs/ms" },
          "end_ms": { "type": "integer", "minimum": 1 },
          "start_frame": { "$ref": "#/$defs/frame" },
          "end_frame": { "type": "integer", "minimum": 1 },
          "style_id": { "$ref": "#/$defs/id" },
          "style_hash": { "$ref": "#/$defs/content_hash" },
          "font_sha256": { "$ref": "#/$defs/hex" },
          "lines": {
            "description": "How the text breaks into lines between its words; the words joined by one space give the text back.",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "baseline_px", "width_px"],
              "properties": {
                "text": { "type": "string", "minLength": 1 },
                "baseline_px": { "type": "integer", "minimum": 0 },
                "width_px": { "type": "integer", "minimum": 0 }
              }
            }
          },
          "words": { "type": "integer", "minimum": 1 },
          "words_per_second": { "type": "number", "minimum": 0 }
        }
      }
    },
    "warnings": {
      "description": "What a person should look at before approving; a warning never blocks and never changes a source.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "subject", "message", "value", "limit"],
        "properties": {
          "code": { "enum": ["reading_speed_high", "card_over_dip"] },
          "subject": { "$ref": "#/$defs/id" },
          "message": { "type": "string", "minLength": 1 },
          "value": { "type": ["number", "null"] },
          "limit": { "type": ["number", "null"] }
        }
      }
    }
  }
}
