{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superyacht.local/schemas/CanonicalDesign",
  "title": "CanonicalDesign (v6.3)",
  "type": "object",
  "required": ["revision", "revision_kind", "hash", "name", "dimensions", "decks", "profile_curve", "plan_outline", "deck_outlines", "landmarks", "surfaces", "build_states", "operational_limits", "rooms"],
  "properties": {
    "revision": {"type": "integer", "minimum": 0},
    "revision_kind": {"enum": ["draft", "locked"]},
    "hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "name": {"type": "string", "minLength": 2, "maxLength": 30},
    "dimensions": {
      "type": "object",
      "required": ["loa", "beam", "draft"],
      "properties": {
        "loa": {"$ref": "#/$defs/length_m"},
        "beam": {"$ref": "#/$defs/length_m"},
        "draft": {"$ref": "#/$defs/length_m"}
      },
      "additionalProperties": {"$ref": "#/$defs/measure"}
    },
    "decks": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["name", "height_m", "start_x", "end_x"],
        "properties": {
          "name": {"type": "string"},
          "height_m": {"type": "number", "exclusiveMinimum": 0},
          "start_x": {"type": "number", "minimum": 0, "maximum": 1},
          "end_x": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "profile_curve": {"type": "array", "minItems": 20, "items": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}},
    "plan_outline": {"type": "array", "minItems": 20, "items": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}},
    "deck_outlines": {"type": "array", "items": {"type": "object"}},
    "landmarks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["x", "z"],
        "properties": {"x": {"type": "number", "minimum": 0, "maximum": 1}, "z": {"type": "number"}}
      }
    },
    "surfaces": {
      "type": "object",
      "required": ["finished", "colors"],
      "properties": {
        "colors": {
          "type": "array",
          "maxItems": 3,
          "items": {"type": "object", "required": ["role", "name", "hex"], "properties": {"hex": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}}}
        }
      }
    },
    "build_states": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "BuildState"}, "description": "exactly BS05-BS12, part of the design lock"},
    "operational_limits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["feature", "allowed_when"],
        "properties": {
          "feature": {"type": "string"},
          "allowed_when": {
            "type": "object",
            "properties": {
              "max_speed_kn": {"type": "number", "minimum": 0},
              "at_anchor_only": {"type": "boolean"},
              "max_sea_state": {"type": "integer", "minimum": 0, "maximum": 9}
            }
          }
        }
      }
    },
    "rooms": {"type": "array", "minItems": 10, "items": {"type": "object", "required": ["id", "deck", "window_type"]}}
  },
  "allOf": [
    {"if": {"properties": {"revision_kind": {"const": "locked"}}}, "then": {"properties": {"revision": {"minimum": 1}}}}
  ],
  "$defs": {
    "measure": {
      "type": "object",
      "required": ["value", "unit", "basis"],
      "properties": {"value": {"type": "number"}, "unit": {"type": "string"}, "basis": {"enum": ["CONCEPT_ASSUMPTION", "DERIVED", "TRACED"]}}
    },
    "length_m": {
      "type": "object",
      "required": ["value", "unit", "basis"],
      "properties": {"value": {"type": "number", "exclusiveMinimum": 0}, "unit": {"const": "m"}, "basis": {"enum": ["CONCEPT_ASSUMPTION", "DERIVED", "TRACED"]}}
    }
  }
}
