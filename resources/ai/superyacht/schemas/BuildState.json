{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superyacht.local/schemas/BuildState",
  "title": "BuildState (v6.3)",
  "type": "object",
  "required": ["id", "kind", "present_parts", "absent_parts", "surfaces_by_part", "compiled_text"],
  "properties": {
    "id": {"type": "string", "pattern": "^BS(0[5-9]|1[0-2])$"},
    "kind": {"enum": ["scale_model", "build", "finished"]},
    "present_parts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/part"}},
    "absent_parts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/part"}},
    "surfaces_by_part": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/part"},
      "additionalProperties": {"enum": ["scale_model_white", "bare_steel", "steel_primer", "raw_aluminium", "protective_film", "filler_primer", "final_paint", "final_glass", "teak", "other_final"]}
    },
    "compiled_text": {"type": "string", "description": "English STATE GEOMETRY + SURFACE STATE generated by code from the fields above"}
  },
  "$defs": {
    "part": {"enum": ["keel_blocks", "hull_shell", "main_deck", "superstructure", "glazing", "hull_doors", "observation_blister", "helideck", "mast", "stern_platform", "terraces", "scaffolding_on_hull"]}
  }
}
