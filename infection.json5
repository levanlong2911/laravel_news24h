// Mutation testing (Infection). File "luật": agent không được sửa (AGENTS.md mục 7).
// Infection cố tình làm sai code (đổi > thành >=, bỏ một dòng...) rồi chạy test.
// Test tốt phải FAIL khi code sai. Tỉ lệ đột biến bị "giết" = MSI.
//
// Cài:  composer require --dev infection/infection
//       (composer.json → "config.allow-plugins": { "infection/extension-installer": true })
// Cần PCOV hoặc Xdebug để đo coverage.
// Chạy trên dòng code thay đổi so với main (nhanh, dùng trong CI cho PR):
//   php vendor/bin/infection --git-diff-lines --git-diff-base=origin/main --threads=max --min-msi=60 --min-covered-msi=75
//
// Ngưỡng 60/75 là mức khởi đầu. Mutation test có giá trị nhất với logic thuần (Actions, Services,
// validator, state transition, tính toán chi phí token...). Code chủ yếu là I/O (gọi API, queue, file)
// thì test bằng tests/Integration thay vì ép MSI. CI chỉ chạy mutation khi đổi app/Actions, app/Services,
// app/Domain, app/Support.
{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["app"],
        "excludes": ["Console", "Exceptions", "Providers", "Http/Middleware"]
    },
    "testFramework": "pest",
    "logs": {
        "text": "storage/logs/infection.log",
        "summary": "storage/logs/infection-summary.log",
    },
    "mutators": {
        "@default": true
    }
}
