# Larastan (PHPStan cho Laravel). File luật: agent không được sửa.
#
# Laravel 10 → Larastan 2.x (Larastan 3 cần Laravel 11+). Composer tự chọn bản phù hợp:
#   composer require --dev larastan/larastan -W
# Chạy:  php vendor/bin/phpstan analyse --memory-limit=1G
#
# Project có sẵn nhiều lỗi: tạo baseline MỘT LẦN rồi bỏ dấu # ở dòng baseline bên dưới.
#   php vendor/bin/phpstan analyse --memory-limit=1G --generate-baseline
# Baseline "đóng băng" lỗi cũ, mọi lỗi MỚI vẫn làm CI fail.
#
# Cài gói cũ nunomaduro/larastan thì đổi dòng include thành:
#   - vendor/nunomaduro/larastan/extension.neon

includes:
    - vendor/larastan/larastan/extension.neon
#   - phpstan-baseline.neon

parameters:
    paths:
        - app
        - routes
        - database/factories
        - database/seeders
    phpVersion: 80200          # phân tích theo PHP 8.2 (khớp XAMPP)
    # 0 (lỏng) → 9/max (chặt). 5 là mức khởi đầu hợp lý cho project có sẵn; nâng dần.
    level: 5
    reportUnmatchedIgnoredErrors: true
