{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://news24h.local/contracts/concept/canonical_design_spec_v1.json",

  "title": "Canonical Design Specification",
  "description": "Provider-independent semantic design contract for one original physical subject.",

  "type": "object",
  "additionalProperties": false,

  "required": [
    "schema_version",
    "object_type",
    "design_thesis",
    "identity",
    "dimensions",
    "permanent_geometry",
    "relationships",
    "form_relationships",
    "finished_materials",
    "exclusions",
    "invariants",
    "provenance"
  ],

  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },

    "object_type": {
      "type": "string",
      "minLength": 1
    },

    "design_thesis": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "text",
        "role"
      ],

      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },

        "role": {
          "type": "string",
          "const": "soft_design_guidance"
        }
      }
    },

    "identity": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "subject_class",
        "identity_basis"
      ],

      "properties": {
        "subject_class": {
          "type": "string",
          "minLength": 1
        },

        "identity_basis": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,

          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },

    "dimensions": {
      "type": "object",
      "description": "Domain-specific measurable dimensions. Exact allowed fields are refined by the category profile."
    },

    "permanent_geometry": {
      "type": "object",
      "description": "Permanent identity-defining geometry. Domain-specific sections are refined by the category profile."
    },

    "relationships": {
      "type": "array",

      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/countRelationship"
          },
          {
            "$ref": "#/$defs/groupingRelationship"
          },
          {
            "$ref": "#/$defs/oneToOneRelationship"
          },
          {
            "$ref": "#/$defs/proportionRelationship"
          },
          {
            "$ref": "#/$defs/positionRelationship"
          },
          {
            "$ref": "#/$defs/orderRelationship"
          },
          {
            "$ref": "#/$defs/continuityRelationship"
          },
          {
            "$ref": "#/$defs/connectivityRelationship"
          },
          {
            "$ref": "#/$defs/symmetryRelationship"
          },
          {
            "$ref": "#/$defs/containmentRelationship"
          },
          {
            "$ref": "#/$defs/alignmentRelationship"
          }
        ]
      }
    },

    "form_relationships": {
      "type": "object",
      "description": "Higher-level form relationships. These may include descriptive text plus structured form semantics."
    },

    "finished_materials": {
      "type": "object",
      "description": "Permanent finished material intent where materially relevant to identity."
    },

    "exclusions": {
      "type": "array",

      "items": {
        "type": "object",
        "additionalProperties": false,

        "required": [
          "id",
          "target_path",
          "forbid"
        ],

        "properties": {
          "id": {
            "type": "string",
            "pattern": "^E[0-9]{3}$"
          },

          "target_path": {
            "type": "string",
            "minLength": 1
          },

          "forbid": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },

    "invariants": {
      "type": "array",
      "minItems": 1,

      "items": {
        "type": "object",
        "additionalProperties": false,

        "required": [
          "id",
          "name",
          "source_path",
          "constraint_type",
          "severity",
          "visual_verification"
        ],

        "properties": {
          "id": {
            "type": "string",
            "pattern": "^I[0-9]{3}$"
          },

          "name": {
            "type": "string",
            "minLength": 1
          },

          "source_path": {
            "type": "string",
            "minLength": 1
          },

          "constraint_type": {
            "$ref": "#/$defs/constraintPrimitive"
          },

          "severity": {
            "type": "string",
            "enum": [
              "hard",
              "soft"
            ]
          },

          "visual_verification": {
            "type": "boolean"
          }
        }
      }
    },

    "provenance": {
      "type": "array",

      "items": {
        "type": "object",
        "additionalProperties": false,

        "required": [
          "target_path",
          "origin",
          "source_aspects"
        ],

        "properties": {
          "target_path": {
            "type": "string",
            "minLength": 1
          },

          "origin": {
            "type": "string",
            "enum": [
              "inspired",
              "invented"
            ]
          },

          "source_aspects": {
            "type": "array",
            "uniqueItems": true,

            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },

  "$defs": {
    "constraintPrimitive": {
      "type": "string",

      "enum": [
        "count",
        "proportion",
        "position",
        "order",
        "connectivity",
        "continuity",
        "visibility",
        "material",
        "state",
        "exclusion",
        "geometry",
        "layout",
        "grouping",
        "alignment",
        "containment",
        "symmetry"
      ]
    },

    "relationshipId": {
      "type": "string",
      "pattern": "^R[0-9]{3}$"
    },

    "countRelationship": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "id",
        "type",
        "subject_path",
        "value"
      ],

      "properties": {
        "id": {
          "$ref": "#/$defs/relationshipId"
        },

        "type": {
          "const": "count"
        },

        "subject_path": {
          "type": "string",
          "minLength": 1
        },

        "value": {
          "type": "integer",
          "minimum": 0
        }
      }
    },

    "groupingRelationship": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "id",
        "type",
        "subject_path",
        "group_count"
      ],

      "properties": {
        "id": {
          "$ref": "#/$defs/relationshipId"
        },

        "type": {
          "const": "grouping"
        },

        "subject_path": {
          "type": "string",
          "minLength": 1
        },

        "group_count": {
          "type": "integer",
          "minimum": 1
        },

        "grouped_into_path": {
          "type": "string"
        },

        "meaning": {
          "type": "string"
        }
      }
    },

    "oneToOneRelationship": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "id",
        "type",
        "source_path",
        "target_path"
      ],

      "properties": {
        "id": {
          "$ref": "#/$defs/relationshipId"
        },

        "type": {
          "const": "one_to_one"
        },

        "source_path": {
          "type": "string",
          "minLength": 1
        },

        "target_path": {
          "type": "string",
          "minLength": 1
        },

        "meaning": {
          "type": "string"
        }
      }
    },

    "proportionRelationship": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "id",
        "type",
        "subject_path",
        "metric",
        "value"
      ],

      "properties": {
        "id": {
          "$ref": "#/$defs/relationshipId"
        },

        "type": {
          "const": "proportion"
        },

        "subject_path": {
          "type": "string",
          "minLength": 1
        },

        "metric": {
          "type": "string",
          "minLength": 1
        },

        "value": {
          "type": "number"
        },

        "tolerance": {
          "type": "number",
          "minimum": 0
        }
      }
    },

    "positionRelationship": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "id",
        "type",
        "subject_path",
        "reference_path",
        "value"
      ],

      "properties": {
        "id": {
          "$ref": "#/$defs/relationshipId"
        },

        "type": {
          "const": "position"
        },

        "subject_path": {
          "type": "string",
          "minLength": 1
        },

        "reference_path": {
          "type": "string",
          "minLength": 1
        },

        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },

    "orderRelationship": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "id",
        "type",
        "items"
      ],

      "properties": {
        "id": {
          "$ref": "#/$defs/relationshipId"
        },

        "type": {
          "const": "order"
        },

        "items": {
          "type": "array",
          "minItems": 2,

          "items": {
            "type": "string",
            "minLength": 1
          }
        },

        "direction": {
          "type": "string"
        }
      }
    },

    "continuityRelationship": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "id",
        "type",
        "subject_path",
        "value"
      ],

      "properties": {
        "id": {
          "$ref": "#/$defs/relationshipId"
        },

        "type": {
          "const": "continuity"
        },

        "subject_path": {
          "type": "string",
          "minLength": 1
        },

        "value": {
          "type": "string",
          "minLength": 1
        },

        "start_path": {
          "type": "string"
        },

        "end_path": {
          "type": "string"
        }
      }
    },

    "connectivityRelationship": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "id",
        "type",
        "members",
        "value"
      ],

      "properties": {
        "id": {
          "$ref": "#/$defs/relationshipId"
        },

        "type": {
          "const": "connectivity"
        },

        "members": {
          "type": "array",
          "minItems": 2,

          "items": {
            "type": "string",
            "minLength": 1
          }
        },

        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },

    "symmetryRelationship": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "id",
        "type",
        "subject_path",
        "axis",
        "value"
      ],

      "properties": {
        "id": {
          "$ref": "#/$defs/relationshipId"
        },

        "type": {
          "const": "symmetry"
        },

        "subject_path": {
          "type": "string",
          "minLength": 1
        },

        "axis": {
          "type": "string",
          "minLength": 1
        },

        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },

    "containmentRelationship": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "id",
        "type",
        "container_path",
        "contained_path"
      ],

      "properties": {
        "id": {
          "$ref": "#/$defs/relationshipId"
        },

        "type": {
          "const": "containment"
        },

        "container_path": {
          "type": "string",
          "minLength": 1
        },

        "contained_path": {
          "type": "string",
          "minLength": 1
        }
      }
    },

    "alignmentRelationship": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "id",
        "type",
        "members",
        "value"
      ],

      "properties": {
        "id": {
          "$ref": "#/$defs/relationshipId"
        },

        "type": {
          "const": "alignment"
        },

        "members": {
          "type": "array",
          "minItems": 2,

          "items": {
            "type": "string",
            "minLength": 1
          }
        },

        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
